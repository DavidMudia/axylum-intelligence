DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:5432/axylum
LOCAL_POSTGRES_PASSWORD=local-development-only
MARKET_DATA_PROVIDER=binance-spot
MARKET_SYMBOL=BTCUSDT
MARKET_INTERVAL=1m
MARKET_BACKFILL_DAYS=30
MARKET_ORDER_BOOK_DEPTH=100
MARKET_ORDER_BOOK_SNAPSHOT_INTERVAL_MS=30000
MARKET_STALE_AFTER_MS=15000
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
PAPER_TRADING_POLL_MS=5000

# Optional legacy operator sign-in; ordinary users use email and password accounts.
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_SESSION_SECRET=

# One-time admin setup/recovery code. Generate with: openssl rand -hex 32
AUTH_BOOTSTRAP_ADMIN_SECRET=

# Reserved for the exchange-credential API; no exchange keys are accepted yet.
EXCHANGE_CREDENTIALS_ENCRYPTION_KEY=

# MT5 bridge tokens are provisioned out-of-band and stored only as a database hash.
# Demo execution is server-gated and disabled by default.
AXYLUM_MT5_DEMO_TRADING_ENABLED=false
AXYLUM_MT5_MAX_SPREAD_POINTS=30

# Public listener configuration. The app binds to 5174 by default.
PORT=5174
