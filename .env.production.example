# Copy to .env.production on the server and chmod 600.
NODE_ENV=production
PORT=5174
HOSTNAME=0.0.0.0
DOMAIN=terminal.example.com

# Use a strong database password and URL-encode reserved characters in DATABASE_URL.
POSTGRES_DB=axylum
POSTGRES_USER=axylum
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://axylum:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@db:5432/axylum

# Optional one-time administrator setup code; it never grants founder/owner privileges.
AUTH_BOOTSTRAP_ADMIN_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Optional legacy operator login. Leave blank to use account-based admin sign-in.
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_SESSION_SECRET=

# Generate with: openssl rand -base64 32
# Encrypts saved exchange credentials and Paystack subscription-management tokens.
EXCHANGE_CREDENTIALS_ENCRYPTION_KEY=

# Subscription billing (set server-side; never expose with a NEXT_PUBLIC_ prefix).
APP_BASE_URL=https://terminal.example.com
PAYSTACK_SECRET_KEY=
PAYSTACK_STARTER_PLAN_CODE=
PAYSTACK_PROFESSIONAL_PLAN_CODE=
# Generate with: openssl rand -hex 32
CRON_SECRET=

# MT5 bridge tokens are provisioned out-of-band and stored only as a database hash.
# Do not put an MT5 token or broker password in this web environment.
AXYLUM_MT5_DEMO_TRADING_ENABLED=false
AXYLUM_MT5_MAX_SPREAD_POINTS=30

MARKET_DATA_PROVIDER=binance-spot
MARKET_SYMBOL=BTCUSDT
MARKET_INTERVAL=1m
MARKET_BACKFILL_DAYS=30
MARKET_ORDER_BOOK_DEPTH=100
MARKET_ORDER_BOOK_SNAPSHOT_INTERVAL_MS=30000
MARKET_STALE_AFTER_MS=15000
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
PAPER_TRADING_POLL_MS=5000
BACKUP_RETENTION_DAYS=14
