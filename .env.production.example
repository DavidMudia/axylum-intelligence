# Copy to .env.production on the server and chmod 600.
NODE_ENV=production
PORT=5174
HOSTNAME=0.0.0.0
DOMAIN=terminal.example.com

# Use a strong database password and URL-encode reserved characters in DATABASE_URL.
POSTGRES_DB=axylum
POSTGRES_USER=axylum
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://axylum:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@db:5432/axylum

# Generate a random secret with: openssl rand -hex 32
ADMIN_USERNAME=operator
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
AUTH_SESSION_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS

MARKET_DATA_PROVIDER=binance-spot
MARKET_SYMBOL=BTCUSDT
MARKET_INTERVAL=1m
MARKET_BACKFILL_DAYS=30
MARKET_ORDER_BOOK_DEPTH=100
MARKET_ORDER_BOOK_SNAPSHOT_INTERVAL_MS=30000
MARKET_STALE_AFTER_MS=15000
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
PAPER_TRADING_POLL_MS=5000
BACKUP_RETENTION_DAYS=14
